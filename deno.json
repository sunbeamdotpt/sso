{
  "name": "@sunbeam/sso-ui",
  "version": "1.0.0-rc14",
  "exports": "./src/main.tsx",
  "tasks": {
    "install": "deno install --allow-scripts",
    "prepare": "deno task install && deno run -A scripts/link-jsr.ts && deno run -A npm:@pandacss/dev@^1.9.1 codegen",
    "dev": "deno run -A npm:vite@^6.0.0",
    "dev:server": "KRATOS_PUBLIC_URL=http://localhost:4433 KRATOS_ADMIN_URL=http://localhost:4434 HYDRA_ADMIN_URL=http://localhost:4445 HYDRA_PUBLIC_URL=http://localhost:4444 cargo run --manifest-path api/Cargo.toml",
    "build": "deno task prepare && deno run -A npm:vite@^6.0.0 build",
    "preview": "deno run -A npm:vite@^6.0.0 preview",
    "check": "deno check src/main.tsx",
    "lint": "deno lint src/",
    "fmt": "deno fmt src/",
    "test": "deno test -A --location http://localhost src/",
    "test:unit": "deno run -A npm:vitest@^3.0.0 run",
    "test:unit:watch": "deno run -A npm:vitest@^3.0.0",
    "test:unit:coverage": "deno run -A npm:vitest@^3.0.0 run --coverage",
    "test:e2e": "deno run -A npm:playwright test",
    "test:e2e:prod": "deno run -A scripts/test-e2e-prod.ts",
    "test:e2e:ui": "deno run -A npm:playwright test --ui",
    "test:e2e:debug": "deno run -A npm:playwright test --debug",
    "audit": "deno audit --level=high",
    "audit:fix": "deno audit --fix",
    "seed:dev": "deno run --allow-net scripts/seed-dev.ts"
  },
  "imports": {
    "@playwright/test": "npm:@playwright/test@1.61.1",
    "@sunbeam/g2v": "npm:@jsr/sunbeam__g2v@^0.3.0",
    "@sunbeam/g2v/rest": "npm:@jsr/sunbeam__g2v@^0.3.0/rest",
    "@sunbeam/g2v/router": "npm:@jsr/sunbeam__g2v@^0.3.0/router",
    "@sunbeam/beam-ui": "npm:@jsr/sunbeam__beam-ui@^0.12.0",
    "@sunbeam/beam-ui/preset": "npm:@jsr/sunbeam__beam-ui@^0.12.0/preset",
    "@primer/octicons-react": "npm:@primer/octicons-react@^19.28.1",
    "playwright": "npm:playwright@^1.61.1",
    "react": "npm:react@^19.2.7",
    "react/jsx-runtime": "npm:react@^19.2.7/jsx-runtime",
    "react-dom": "npm:react-dom@^19.2.7",
    "@types/react": "npm:@types/react@^19.2.17",
    "@types/react-dom": "npm:@types/react-dom@^19.2.3",
    "@tanstack/react-router": "npm:@tanstack/react-router@^1.170.16",
    "@tanstack/react-query": "npm:@tanstack/react-query@^5.101.1",
    "@legendapp/state": "npm:@legendapp/state@^2.1.15",
    "@ark-ui/react": "npm:@ark-ui/react@^5.37.2",
    "@pandacss/dev": "npm:@pandacss/dev@^1.11.3",
    "vite": "npm:vite@^8.1.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.0.3",
    "vitest": "npm:vitest@^4.1.9",
    "@vitest/coverage-v8": "npm:@vitest/coverage-v8@^4.1.9",
    "happy-dom": "npm:happy-dom@^20.10.6",
    "@testing-library/react": "npm:@testing-library/react@^16.3.2",
    "@testing-library/jest-dom": "npm:@testing-library/jest-dom@^6.9.1",
    "typescript": "npm:typescript@^6.0.3",
    "styled-system/css": "./styled-system/css/index.mjs",
    "styled-system/": "./styled-system/"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "types": [
      "./src/vite-env.d.ts"
    ]
  }
}
